{
  "version": 3,
  "manifest": {
    "from": ".cursor-plugin/plugin.json",
    "keep": [
      "name",
      "version",
      "description",
      "author",
      "homepage",
      "repository",
      "license",
      "keywords"
    ],
    "add": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
    },
    "dropToExtension": [
      "displayName",
      "logo",
      "category",
      "tags",
      "skills",
      "agents"
    ],
    "extension": {
      "namespace": "com.cursor",
      "file": "plugin.json"
    }
  },
  "frontmatter": {
    "name": "lowercase+equalDirname",
    "moveToMetadata": {
      "mode": "mode: session",
      "reminder": "reminder",
      "is_background": "is_background"
    },
    "keep": [
      "disable-model-invocation"
    ],
    "drop": [
      "icon",
      "color"
    ]
  },
  "bodyTokens": [
    {
      "find": "AskQuestion",
      "replace": "结构化提问(问题数组 + 选项 + 多选)",
      "note": "四端等价表见 MAPPING.md"
    },
    {
      "find": "subagent_type: \"poteto-agent\"",
      "replace": "以类型名 poteto-agent 委派子代理",
      "note": "agent 注册表见 agents/"
    },
    {
      "find": "subagent_type: \"Comment Sicko\"",
      "replace": "子代理类型: \"comment-sicko\"",
      "note": "与 agents/comment-sicko.md 的注册名对齐;须排在裸 subagent_type 之前"
    },
    {
      "find": "/loop",
      "replace": "循环执行直到谓词满足(间隔唤醒)",
      "gatePattern": "(?<![\\w./-])/loop(?![\\w-])",
      "note": "等价:CC/Cursor /loop,Codex 后台模式,其他 CLI harness goal/ralph"
    },
    {
      "find": "~/.cursor/rules/pstack-models.mdc",
      "replace": "pstack-models.json",
      "note": "全路径形态;必须排在裸文件名形态之前"
    },
    {
      "find": "pstack-models.mdc",
      "replace": "pstack-models.json",
      "note": "裸文件名形态"
    },
    {
      "find": "cursor-team-kit",
      "replace": "可选组件(由上游配套插件提供,本包未捆绑;请按所用客户端的等价组件选用)"
    },
    {
      "find": "subagent_type",
      "replace": "子代理类型"
    },
    {
      "find": "generalPurpose",
      "replace": "通用型子代理"
    },
    {
      "find": "~/.cursor/skills",
      "replace": "~/.agents/skills"
    },
    {
      "find": ".cursor/skills",
      "replace": ".agents/skills"
    },
    {
      "find": "~/.cursor/projects",
      "replace": "会话转录目录"
    },
    {
      "find": "~/.cursor/plugins",
      "replace": "插件安装目录"
    },
    {
      "find": ".cursor/worktrees",
      "replace": "worktree 目录"
    },
    {
      "find": "agent-transcripts",
      "replace": "session-transcripts"
    },
    {
      "find": "https://api2.cursor.sh/automations/webhook/",
      "replace": "(Cursor 专属端点;等价做法:改用目标应用的 webhook 接收端点)"
    }
  ],
  "residualPatterns": [
    "mode: true",
    "icon: crown",
    "color: yellow",
    "pstack-models\\.mdc",
    "\\.cursor/(projects|plugins|worktrees|skills|rules)",
    "api2\\.cursor\\.sh"
  ],
  "codeResidualAllowlist": [
    {
      "path": "skills/poteto-mode/scripts/worktree-audit.sh",
      "patterns": [
        "\\.cursor/(projects|plugins|worktrees|skills|rules)",
        "~/.cursor/projects",
        "agent-transcripts"
      ],
      "reason": "转录目录在脚本里是字符串常量(变量与注释);散文式替换会破坏脚本行为,显式登记为已知残留"
    },
    {
      "path": "skills/poteto-mode/scripts/check-plan.mjs",
      "patterns": [
        "/loop"
      ],
      "reason": "程序标记字符串字面量(用于识别唤醒机制),非文档散文;机械替换会改变脚本行为"
    },
    {
      "path": "skills/poteto-mode/scripts/check-plan.test.ts",
      "patterns": [
        "/loop"
      ],
      "reason": "测试夹具复刻程序清单文本,以 /loop 字面量断言解析结果;机械替换会改变测试语义"
    }
  ],
  "apContract": {
    "source": "agent-plugins.org schemas/1.0.0/plugin.schema.json (draft 2020-12; additionalProperties: false)",
    "schemaId": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "allowedKeys": [
      "$schema",
      "name",
      "version",
      "description",
      "author",
      "homepage",
      "repository",
      "license",
      "keywords",
      "extensions"
    ],
    "requiredKeys": [
      "$schema",
      "name"
    ],
    "namePattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
    "maxNameLength": 64,
    "authorKeys": [
      "name",
      "email",
      "url"
    ]
  },
  "agents": {
    "policy": "registry",
    "dir": "agents/"
  },
  "sampleSkills": []
}
